{
    "name": "wisnu-agustya2/hr-attendance",
    "description": "Aplikasi absensi dan cuti karyawan dengan CodeIgniter 4: check-in/out, pengajuan cuti, dan rekap bulanan.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
